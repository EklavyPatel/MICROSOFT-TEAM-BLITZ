{
  "name": "watchcircle-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5 <25"
  },
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env --watch src/server.js",
    "start": "node --use-env-proxy --env-file-if-exists=.env src/server.js",
    "db:init": "node --use-env-proxy --env-file-if-exists=.env src/db/init.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node --use-env-proxy tests/smoke.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "html-to-text": "^9.0.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
